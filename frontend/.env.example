# ==========================================
# MAYANK SONI PORTFOLIO — ENVIRONMENT CONFIG
# ==========================================

# 🎵 Spotify Web API Integration
# 1. Go to Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# 2. Create an App, set Redirect URI to: http://localhost:3000/api/spotify/callback
# 3. Request user-read-currently-playing and user-read-recently-played scopes
# 4. Exchange authorization code for a Refresh Token
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# 🎌 Anime Corner (AniList / MyAnimeList)
# AniList uses public GraphQL API. No API key required.
# Simply set your username below (default: mayanks0ni)
ANILIST_USERNAME=mayanks0ni

# 💬 Discord Social & Rich Presence (Lanyard)
# To enable real-time Discord coding presence on your hosted portfolio:
# 1. Join the Lanyard Discord server once: https://discord.gg/lanyard
# 2. Provide your Discord Snowflake ID below:
DISCORD_USER_ID=516247416878530560
NEXT_PUBLIC_DISCORD_TAG=mayanks0ni

# ⚡ Real-Time Coding Presence Sync (Optional / Direct Daemon)
# Secret to authenticate local heartbeat pings from scripts/presence-sync.mjs
PRESENCE_SYNC_SECRET=your_optional_sync_secret

# Optional: Upstash Redis (for persistence across serverless lambdas)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# 🤖 Moonlit AI Terminal Companion (Optional - Gemini API)
# API_KEY=your_gemini_api_key

